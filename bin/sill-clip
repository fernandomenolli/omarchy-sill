#!/usr/bin/env bash
# Puts what the shelf is holding onto the clipboard.
#
#   sill-clip files <path>...   the files themselves, so a paste lands a copy
#   sill-clip text <string>     plain text, for links and snippets
#
# Files go out as x-special/gnome-copied-files, which is what a file manager
# and a GTK file dialog read as "these are files". A path pasted as text would
# only ever be a path.

set -euo pipefail

command -v wl-copy >/dev/null || { echo "sill-clip: wl-copy is not installed" >&2; exit 1; }

case "${1:-}" in
  files)
    shift
    (($# > 0)) || { echo "sill-clip: no files given" >&2; exit 2; }
    {
      printf 'copy'
      for path in "$@"; do
        printf '\nfile://%s' "$path"
      done
    } | wl-copy --type x-special/gnome-copied-files
    ;;
  text)
    shift
    printf '%s' "${1:-}" | wl-copy
    ;;
  *)
    echo "usage: sill-clip files <path>... | sill-clip text <string>" >&2
    exit 2
    ;;
esac
